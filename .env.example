# Senha única do painel administrativo.
ADMIN_PASSWORD=troque-esta-senha

# Alternativa segura: hash scrypt no formato scrypt:<saltHex>:<hashHex>.
# Gere com: npm run admin:hash -- "sua-senha"
# ADMIN_PASSWORD_HASH=

# Segredo usado para assinar o cookie de sessão. Use algo longo e aleatório.
AUTH_SECRET=gere-uma-string-longa-e-aleatoria

# Origem do site (usada no proxy local e na checagem de origem).
APP_ORIGIN=http://localhost:4200

# Upstash Redis (obrigatório em produção).
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Vercel Blob (recomendado em produção; em dev usa .data/uploads).
# BLOB_READ_WRITE_TOKEN=
# BLOB_PRIVATE_READ_WRITE_TOKEN=

# Tempo de reserva de estoque antes de expirar um pedido PIX.
HOLD_HOURS=24

# Limite de upload (comprovantes e imagens).
MAX_UPLOAD_MB=8

# Pasta de dados local (fallback sem Redis).
# DATA_DIR=.data
