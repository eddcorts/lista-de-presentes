{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "framework": "angular",
    "buildCommand": "npm run build",
    "outputDirectory": "dist/site-niver/browser",
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": "/api/index"
        },
        {
            "source": "/((?!api/).*)",
            "destination": "/index.html"
        }
    ]
}
